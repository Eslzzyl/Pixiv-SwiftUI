        }
      }
    },
    "开启“导出插画元数据”后，会在下载的图片中嵌入插画 ID、作者、标题、简介、标签等信息。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When \"Export Illustration Metadata\" is enabled, illustration ID, author, title, description, tags, and other information will be embedded in the downloaded images."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“导出插画元数据”后，会在下载的图片中嵌入插画 ID、作者、标题、简介、标签等信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「匯出插畫中繼資料」後，會在下載的圖片中嵌入插畫 ID、作者、標題、簡介、標籤等資訊。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「イラストのメタデータを書き出す」を有効にすると、ダウンロードした画像にイラストID、作者、タイトル、説明、タグなどの情報を埋め込みます。"
          }
        }
      }
    },
    "开启后，应用切到后台或进入最近任务时会模糊当前页面预览" : {
