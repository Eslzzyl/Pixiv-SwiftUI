        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录凭证拥有与密码等同的访问权限，请妥善保管，切勿分享给他人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
