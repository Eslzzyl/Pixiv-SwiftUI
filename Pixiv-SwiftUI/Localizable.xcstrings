    "登录凭证拥有与密码等同的完全访问权限，可用于第三方工具或脚本登录。请妥善保管，切勿向不可信的第三方公开或在非安全环境中分享。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Login credentials grant full access equivalent to your password and can be used to sign in via third-party tools or scripts. Keep them safe and never share them with untrusted third parties or in insecure environments."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录凭证拥有与密码等同的完全访问权限，可用于第三方工具或脚本登录。请妥善保管，切勿向不可信的第三方公开或在非安全环境中分享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入憑證擁有與密碼等同的完整存取權限，可用於第三方工具或指令碼登入。請妥善保管，切勿向不可信的第三方公開或在不安全的環境中分享。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン認証情報にはパスワードと同等の完全なアクセス権があり、サードパーティ製ツールやスクリプトでのログインに使用できます。大切に保管し、信頼できない第三者に公開したり、安全でない環境で共有したりしないでください。"
          }
        }
      }
    },
    "登录凭证拥有与密码等同的访问权限，请妥善保管，切勿分享给他人。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Login credentials grant access equivalent to your password. Keep them safe and do not share them."
